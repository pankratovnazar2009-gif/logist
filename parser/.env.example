# ── Backend API — единственная точка, куда парсер ходит за списком групп и куда шлёт ──
# ── структурированные посты. Прямого доступа к Supabase у парсера нет.               ──
BACKEND_URL=http://localhost:3000       # локально; в проде — https://<проект>.vercel.app
INTERNAL_API_KEY=change-me-too          # тот же секрет, что в backend/.env

# ── OpenAI (структурирование текста поста в JSON) ──────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Facebook сессия ──────────────────────────────────────────────────────
# Скрипт НЕ логинится сам — он открывает Facebook уже с сохранённой сессией
# (storage_state), которую нужно один раз создать вручную командой:
#   python parser/save_session.py
# Это принципиально: логин/капчу/чекпоинт скрипт не проходит автоматически —
# если FB покажет проверку, скрипт останавливается и требует обновить сессию вручную.
FB_STORAGE_STATE_PATH=./fb_storage_state.json

POLL_INTERVAL_SECONDS=900
