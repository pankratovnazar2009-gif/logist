# Локально: скопируй в .env.local. На Vercel: Project → Settings → Environment Variables.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # Settings → API Keys → Secret key (только сервер!)

# ── Сессии и внутренний API ─────────────────────────────────────────────────
APP_JWT_SECRET=change-me-to-a-long-random-string   # >= 16 символов
INTERNAL_API_KEY=change-me-too                     # тот же секрет — в parser/.env

# ── SMS: smsapi | twilio ────────────────────────────────────────────────────
SMS_PROVIDER=smsapi
SMSAPI_TOKEN=
SMSAPI_SENDER_NAME=                                # пусто = отправитель по умолчанию
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── GUS / REGON (ключ: https://api.stat.gov.pl/Home/RegonApi) ───────────────
GUS_API_KEY=abcde12345abcde12345                   # публичный тестовый ключ
GUS_ENV=test                                       # test | prod

# ── Публичный адрес для ссылок в SMS (на Vercel можно не задавать) ──────────
APP_BASE_URL=http://localhost:3000

# ── Личный номер владельца (необязательно) ───────────────────────────────────
# Сюда шлём SMS «для груза из FB нашёлся перевозчик» и напоминание спросить результат через сутки —
# дальше владелец сам пишет заказчику в Facebook. Пусто = эти два SMS не отправляются.
OWNER_NOTIFY_PHONE=
