# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # Project Settings → API → service_role (СЕКРЕТНЫЙ, только на backend)

# ── Наш собственный JWT для сессий (не путать с Supabase Auth JWT) ─────────
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_TTL=30d

# ── Внутренний ключ для вызовов от парсера (Python) ────────────────────────
INTERNAL_API_KEY=change-me-too

# ── SMS-провайдер: smsapi | twilio ──────────────────────────────────────────
SMS_PROVIDER=smsapi

# SMSAPI.pl (https://ssl.smsapi.pl/oauth/authorize -> token OAuth или личный токен из panelu)
SMSAPI_TOKEN=
SMSAPI_SENDER_NAME=LogistApp

# Twilio (альтернатива)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── GUS / REGON API (бесплатный ключ: https://api.stat.gov.pl/Home/RegonApi) ─
GUS_API_KEY=abcde12345abcde12345      # тестовый публичный ключ по умолчанию, для прод — свой
GUS_ENV=test                          # test | prod

PORT=4000
APP_BASE_URL=http://localhost:3000     # для коротких ссылок в SMS (веб-страница груза)
